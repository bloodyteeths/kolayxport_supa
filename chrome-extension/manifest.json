{
  "manifest_version": 3,
  "name": "Kolayxport Etsy Order Sync",
  "version": "3.4.0",
  "description": "Automatically sync Etsy Shop Manager orders with Kolayxport for streamlined shipping label generation",
  "author": "Kolayxport",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "alarms",
    "notifications",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "https://kolayxport.com/app/*",
    "https://kolayxport.com/*",
    "https://*.kolayxport.com/*",
    "https://www.etsy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/your/orders/*",
        "https://www.etsy.com/your/shops/*/tools/listings/orders*",
        "https://www.etsy.com/your/shops/*/orders*",
        "https://www.etsy.com/your/account/your-shop/orders*",
        "https://www.etsy.com/shop-manager/*orders*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Kolayxport Etsy Sync Status",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "88"
}