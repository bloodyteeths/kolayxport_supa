{
  "manifest_version": 3,
  "name": "KolayXport — Etsy, eBay & Amazon Research Tool",
  "version": "9.3.0",
  "description": "Inline sales estimates, SEO scores, competition analysis & revenue data on Etsy, eBay and Amazon pages. AI-powered alternative to Helium 10.",
  "author": "Kolayxport",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://kolayxport.com/*",
    "https://www.kolayxport.com/*",
    "https://www.etsy.com/*",
    "https://www.ebay.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.it/*",
    "https://www.ebay.es/*",
    "https://www.ebay.com.au/*",
    "https://www.amazon.com/*",
    "https://www.amazon.com.tr/*",
    "https://www.amazon.de/*",
    "https://www.amazon.co.uk/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/*"],
      "js": ["src/cache.js", "src/content-shared.js", "src/content-search.js", "src/content-listing.js", "src/content-shop.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "https://www.etsy.com/your/*",
        "https://www.etsy.com/shop-manager/*"
      ]
    },
    {
      "matches": [
        "https://www.etsy.com/your/orders/*",
        "https://www.etsy.com/your/shops/*/tools/listings/orders*",
        "https://www.etsy.com/your/shops/*/orders*",
        "https://www.etsy.com/your/account/your-shop/orders*",
        "https://www.etsy.com/shop-manager/*orders*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://kolayxport.com/*",
        "https://www.kolayxport.com/*"
      ],
      "js": ["src/kolayxport.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.ebay.com/*",
        "https://www.ebay.co.uk/*",
        "https://www.ebay.de/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.it/*",
        "https://www.ebay.es/*",
        "https://www.ebay.com.au/*"
      ],
      "js": ["src/cache.js", "src/content-ebay-shared.js", "src/content-ebay-search.js", "src/content-ebay-listing.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.com.tr/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": ["src/cache.js", "src/content-amazon-shared.js", "src/content-amazon-search.js", "src/content-amazon-listing.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background-simple.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "KolayXport Etsy & eBay Senkron Durumu",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "externally_connectable": {
    "matches": [
      "https://kolayxport.com/*",
      "https://www.kolayxport.com/*"
    ],
    "ids": []
  },
  "minimum_chrome_version": "88"
}
