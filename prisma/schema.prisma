model WebhookEvent {
  id           String   @id
  /// Provider that fired this event: stripe | wix | shopify | etsy | ebay | ...
  provider     String?
  /// Provider-specific event name, e.g. "invoice.payment_succeeded".
  eventType    String?
  /// received | processed | failed | ignored
  status       String?
  /// Short, redacted error string. Never the raw payload.
  errorMessage String?
  /// Tenant the event acted on, if resolvable. Null when no user could be matched.
  userId       String?
  createdAt    DateTime @default(now())

  // ---- Async processing queue (used by Etsy webhooks; null for Stripe) ----
  // Etsy status lifecycle: received | processing | done | ignored | failed
  /// Verified webhook body. Etsy payloads carry ids only (no buyer PII).
  payload       Json?
  /// Processing attempts so far.
  attempts      Int       @default(0)
  /// When the processor may next pick this event up (null = not queued).
  nextAttemptAt DateTime?
  /// When processing last finished (done/ignored/failed/coalesced).
  processedAt   DateTime?
  /// Provider shop/account id the event belongs to (Etsy shop_id).
  shopId        String?
  /// Coalescing key, e.g. "listing:123" or "receipt:456".
  resourceKey   String?

  // ---- Event backbone (W1) ----
  // Etsy status vocabulary adds 'coalesced' | 'blocked_reauth'. Terminal stays
  // 'failed'; errors keep using errorMessage.
  /// Union of event types absorbed by this (winning) row.
  eventTypes          String[]  @default([])
  /// 0 = critical ... higher = less urgent.
  priority            Int       @default(5)
  processingStartedAt DateTime?
  heartbeatAt         DateTime?
  /// min(createdAt) of the rows this winner absorbed.
  firstReceivedAt     DateTime?
  note                String?
  /// Defers (rate limit/budget/lock) that did not consume an attempt.
  deferrals           Int       @default(0)

  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([provider, status, nextAttemptAt])
  @@index([provider, shopId, resourceKey])
  @@index([provider, status, priority, nextAttemptAt])
  @@index([provider, shopId, status])
}

/// Local per-day Etsy API call counters (fallback when no quota header was seen).
