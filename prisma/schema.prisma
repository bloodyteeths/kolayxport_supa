generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id                  String              @id
  name                String?
  email               String?             @unique
  emailVerified       DateTime?
  image               String?
  googleAccountId     String?             @unique
  googleSheetId       String?             @unique
  driveFolderId       String?
  userAppsScriptId    String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastSyncedAt        DateTime?
  onboardingStep      Int?                @default(0)
  shippingSettings    Json?
  billingInterval     String?
  labelCount          Int                 @default(0)
  orderSyncCount      Int                 @default(0)
  stripeCustomerId    String?             @unique
  subscriptionPlan    String?
  subscriptionStatus  String?
  trialExpiresAt      DateTime?
  usageResetAt        DateTime?
  accounts            Account[]
  marketplaceConfigs  MarketplaceConfig[]
  orders              Order[]
  products            Product[]
  sessions            Session[]
  shipperProfile      ShipperProfile?
  syncLogs            SyncLog[]
  syncOperations      SyncOperation[]
  integrationSettings Credential?
  etsyAddresses       EtsyAddress[]
  trackingSubmissions TrackingSubmission[] @relation("UserTrackingSubmissions")
  senkronOrderData    SenkronOrderData[] @relation("UserSenkronData")
  etsyShops           EtsyShop[] @relation("UserEtsyShops")
  ebayTrackedProducts EbayTrackedProduct[]
  ebayTrackedSellers  EbayTrackedSeller[]
  ebayNicheResearch   EbayNicheResearch[]
  rankTrackedKeywords RankTrackedKeyword[]
  arbitrageScanJobs   ArbitrageScanJob[]
  arbitrageResults    ArbitrageResultRecord[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MarketplaceConfig {
  id        String   @id @default(cuid())
  userId    String
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                          String         @id @default(cuid())
  userId                      String
  marketplace                 String
  marketplaceKey              String
  customerName                String?
  status                      String?
  currency                    String?
  totalPrice                  Float?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  orderNumber                 String
  shippingAddress             Json?
  rawData                     Json?
  labelStatus                 String?
  commodityDesc               String?
  countryOfMfg                String?
  dimensionUnits              String?
  fedexDutiesPaymentType      String?
  fedexPackagingType          String?
  fedexPickupType             String?
  fedexServiceType            String?
  harmonizedCode              String?
  labelStockType              String?
  packageHeight               Float?
  packageLength               Float?
  packageWidth                Float?
  sendCommercialInvoiceViaEtd Boolean?       @default(true)
  shipmentStatus              String?
  shippedAt                   DateTime?
  shippingChargesPaymentType  String?
  shippingLabelUrl            String?
  signatureType               String?
  termsOfSale                 String?        @default("DDU")
  trackingNumber              String?
  weightKg                    Float?         @default(0.5)
  externalStatus              String?
  uiOrderDate                 DateTime?
  items                       OrderItem[]    @relation("OrderToOrderItem")
  user                        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments                   Shipment[]     @relation("OrderToShipment")
  shipping                    OrderShipping? @relation("OrderToOrderShipping")
  trackingSubmissions         TrackingSubmission[] @relation("OrderTrackingSubmissions")
  senkronData                 SenkronOrderData? @relation("OrderSenkronData")

  @@unique([userId, marketplace, marketplaceKey])
  @@index([userId])
  @@index([marketplace, marketplaceKey])
  @@index([userId, labelStatus])
  @@index([userId, createdAt])
  @@index([userId, externalStatus])
  @@index([userId, marketplace])
  @@index([userId, uiOrderDate])
}

model OrderItem {
  id             String     @id @default(cuid())
  orderId        String
  sku            String?
  productName    String?
  variantInfo    String?
  quantity       Int        @default(1)
  unitPrice      Decimal?   @db.Decimal(10, 2)
  totalPrice     Decimal?   @db.Decimal(10, 2)
  notes          String?
  image          String     @default("")
  marketplaceKey String?
  shipBy         DateTime?
  orderNumber    String?
  uniqueLineKey  String?
  productId      String?
  remoteLineId   String?
  countryOfMfg   String?
  harmonizedCode String?
  weightKg       Float?     @default(0.5)
  recipientEmail String?    @map("recipient_email")
  labelJobs      LabelJob[]
  order          Order      @relation("OrderToOrderItem", fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?   @relation(fields: [productId], references: [id])
  shipments      Shipment[]

  @@unique([remoteLineId, orderId], name: "remoteLineId_orderId")
  @@index([orderId])
  @@index([sku])
  @@index([orderId, sku])
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String
  name                String
  description         String?
  price               Decimal              @db.Decimal(10, 2)
  cost                Decimal?             @db.Decimal(10, 2)
  weight              Float?
  dimensions          Json?
  imageUrl            String?
  active              Boolean              @default(true)
  userId              String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  countryOfMfg        String?
  harmonizedCode      String?
  inventories         Inventory[]
  marketplaceProducts MarketplaceProduct[]
  orderItems          OrderItem[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
}

model Inventory {
  id           String   @id @default(cuid())
  productId    String
  location     String   @default("default")
  quantity     Int      @default(0)
  reorderLevel Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
}

model MarketplaceProduct {
  id              String   @id @default(cuid())
  productId       String
  marketplace     String
  marketplaceId   String
  marketplaceData Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([marketplace, marketplaceId])
}

model Credential {
  id                    String   @id @default(cuid())
  userId                String   @unique
  veeqoApiKey           String?
  shippoToken           String?
  fedexApiKey           String?
  fedexApiSecret        String?
  fedexAccountNumber    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  fedexMeterNumber      String?
  hepsiburadaApiKey     String?
  hepsiburadaMerchantId String?
  trendyolApiKey        String?
  trendyolApiSecret     String?
  trendyolSupplierId    String?
  upsAccountNumber      String?
  upsApiKey             String?
  upsApiSecret          String?
  parasutClientId       String?
  parasutClientSecret   String?
  parasutUsername       String?
  parasutPassword       String?
  parasutCompanyId      String?
  etsyAccessToken       String?
  etsyRefreshToken      String?
  etsyShopId            String?
  etsyTokenExpiresAt    DateTime?
  ebayAccessToken       String?
  ebayRefreshToken      String?
  ebayTokenExpiresAt    DateTime?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShipperProfile {
  id                                String   @id @default(uuid())
  userId                            String   @unique
  shipperName                       String?
  shipperPersonName                 String?
  shipperPhoneNumber                String?
  shipperStreet1                    String?
  shipperStreet2                    String?
  shipperCity                       String?
  shipperStateCode                  String?
  shipperPostalCode                 String?
  shipperCountryCode                String?
  shipperTinNumber                  String?
  importerOfRecord                  String?
  fedexFolderId                     String?
  defaultCurrencyCode               String?  @default("USD")
  dutiesPaymentType                 String?  @default("SENDER")
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
  defaultCountryOfMfg               String?
  defaultHarmonizedCode             String?
  defaultPackagingType              String?
  defaultServiceType                String?
  defaultWeightKg                   Float?
  shipperTinType                    String?
  defaultShippingChargesPaymentType String?  @default("SENDER")
  user                              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LabelJob {
  id             String    @id @default(cuid())
  orderItemId    String
  carrier        String
  status         String
  pdfUrl         String?
  trackingNumber String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
}

model SenkronOrderData {
  id             String   @id @default(cuid())
  orderId        String   @unique
  userId         String
  internalNote   String?  // User's internal notes for the order
  customStatus   String?  // User's custom status (İptal, Üretimde, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation("OrderSenkronData", fields: [orderId], references: [id], onDelete: Cascade)
  user           User     @relation("UserSenkronData", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
}

model Shipment {
  id              String     @id @default(cuid())
  orderId         String
  orderItemId     String?
  carrier         String
  status          String
  pdfUrl          String?
  trackingNumber  String?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  serviceType     String?
  iossNumber      String?
  isEdi           Boolean?   @default(true)
  packageType     String?
  signatureOption String?
  order           Order      @relation("OrderToShipment", fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@index([orderId, status])
}

model SyncLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  userId    String?
  operation String?
  details   Json?
  error     String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([level])
}

model SyncOperation {
  id        String          @id @default(cuid())
  userId    String
  type      String
  status    String
  metrics   Json
  retryOf   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  retryFrom SyncOperation?  @relation("RetryRelation", fields: [retryOf], references: [id], onDelete: Restrict, onUpdate: Restrict)
  retries   SyncOperation[] @relation("RetryRelation")
  user      User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model OrderShipping {
  id          String   @id @default(cuid())
  orderId     String   @unique
  firstName   String
  lastName    String?
  company     String?
  street1     String
  street2     String?
  city        String
  state       String?
  postalCode  String
  countryCode String
  phone       String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation("OrderToOrderShipping", fields: [orderId], references: [id], onDelete: Cascade)
}

model EtsyAddress {
  id              String   @id @default(cuid())
  userId          String
  orderNumber     String
  etsyStoreId     String?  // Etsy shop ID for multi-store support
  etsyStoreName   String?  // Human-readable store name
  shippingAddress Json
  notes           String?
  shipByDate      String?  // Ship by date from Etsy (e.g. "Ship by tomorrow")
  orderDate       String?  // Order date from Etsy
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, etsyStoreId, orderNumber])
  @@index([userId, orderNumber])
  @@index([userId, etsyStoreId, orderNumber])
  @@index([orderNumber])
  @@index([createdAt])
}

model TrackingSubmission {
  id              String   @id @default(cuid())
  orderId         String
  trackingNumber  String
  carrierId       Int
  carrierName     String
  notifyCustomer  Boolean  @default(true)
  updateRemoteOrder Boolean @default(true)
  submittedAt     DateTime @default(now())
  submittedBy     String
  status          String   @default("submitted")
  errorMessage    String?
  veeqoResponse   Json?
  
  order           Order    @relation("OrderTrackingSubmissions", fields: [orderId], references: [id], onDelete: Cascade)
  user            User     @relation("UserTrackingSubmissions", fields: [submittedBy], references: [id], onDelete: Cascade)

  @@unique([orderId, trackingNumber])
  @@index([orderId])
  @@index([submittedBy])
  @@index([submittedAt])
  @@index([orderId, trackingNumber])
}

model EtsyShop {
  id              String    @id @default(cuid())
  userId          String
  shopId          String    // Etsy shop ID
  shopName        String?   // Human readable shop name
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  isDefault       Boolean   @default(false)  // Default shop for this user
  isActive        Boolean   @default(true)   // Can be disabled without deleting
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation("UserEtsyShops", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])  // One record per user-shop combination
  @@index([userId])
  @@index([shopId])
}

model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// eBay Product Intelligence
// ---------------------------------------------------------------------------

model EbayTrackedProduct {
  id                String   @id @default(cuid())
  userId            String
  legacyItemId      String
  itemId            String?
  title             String
  imageUrl          String?
  categoryId        String?
  categoryPath      String?
  seller            String?
  condition         String?
  currentPrice      Float?
  currency          String   @default("USD")
  currentQuantity   Int?
  totalSold         Int?
  itemWebUrl        String?
  notes             String?
  tags              String[]
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastCheckedAt     DateTime?
  snapshots         EbayPriceSnapshot[]
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, legacyItemId])
  @@index([userId])
  @@index([userId, isActive])
}

model EbayPriceSnapshot {
  id               String   @id @default(cuid())
  trackedProductId String
  price            Float
  currency         String   @default("USD")
  quantity         Int?
  soldQuantity     Int?
  timestamp        DateTime @default(now())
  trackedProduct   EbayTrackedProduct @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)

  @@index([trackedProductId])
  @@index([trackedProductId, timestamp])
}

model EbayTrackedSeller {
  id             String   @id @default(cuid())
  userId         String
  sellerUsername String
  feedbackScore  Int?
  feedbackPct    String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastCheckedAt  DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerUsername])
  @@index([userId])
}

model EbayNicheResearch {
  id             String   @id @default(cuid())
  userId         String
  query          String
  categoryId     String?
  categoryName   String?
  marketplace    String   @default("EBAY_US")
  totalResults   Int?
  avgPrice       Float?
  medianPrice    Float?
  uniqueSellers  Int?
  demandScore    Int?
  competitionScore Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Etsy Keyword Rank Tracking
// ---------------------------------------------------------------------------

model RankTrackedKeyword {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etsyShopId      String
  etsyListingId   String
  listingTitle    String   @default("")
  keyword         String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  snapshots       RankSnapshot[]

  @@unique([userId, etsyListingId, keyword])
  @@index([userId, isActive])
  @@index([etsyListingId])
}

model RankSnapshot {
  id           String   @id @default(cuid())
  keywordId    String
  keyword      RankTrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  rank         Int?
  page         Int?
  totalResults Int      @default(0)
  checkedAt    DateTime @default(now())

  @@index([keywordId, checkedAt])
}

// ---------------------------------------------------------------------------
// Trendyol → eBay Arbitrage
// ---------------------------------------------------------------------------

model ArbitrageCache {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ArbitrageScanJob {
  id             String   @id @default(cuid())
  userId         String
  status         String   @default("pending") // pending | processing | completed | failed | cancelled
  categorySlugs  String[]
  params         Json     // scan parameters
  progress       Int      @default(0)
  totalProducts  Int      @default(0)
  resultsCount   Int      @default(0)
  processedSlugs String[] // tracks which categories have been processed
  exchangeRate   Float?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  results        ArbitrageResultRecord[]
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model ArbitrageResultRecord {
  id                String   @id @default(cuid())
  scanJobId         String?
  userId            String
  trendyolProductId Int
  trendyolName      String
  trendyolBrand     String
  trendyolPriceTry  Float
  trendyolImageUrl  String?
  trendyolUrl       String?
  trendyolCategory  String?
  ebayMedianPrice   Float
  ebayAvgPrice      Float
  ebayListingCount  Int
  ebayAvgSold       Float
  ebayCategoryId    String?
  ebayCategoryName  String?
  ebayTopItems      Json
  translatedQuery   String?
  matchTier         String?  // gtin | gemini | fallback
  profitUsd         Float
  roiPercent        Float
  marginPercent     Float
  totalCostUsd      Float
  score             Int
  verdict           String   // excellent | good | marginal | skip
  financials        Json
  exchangeRate      Float
  isTracked         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  scanJob           ArbitrageScanJob? @relation(fields: [scanJobId], references: [id], onDelete: SetNull)
  priceHistory      ArbitragePricePoint[]
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trendyolProductId])
  @@index([userId, score])
  @@index([userId, verdict])
  @@index([userId, isTracked])
  @@index([scanJobId])
}

model ArbitragePricePoint {
  id                String   @id @default(cuid())
  arbitrageResultId String
  trendyolPriceTry  Float
  ebayMedianPrice   Float
  exchangeRate      Float
  profitUsd         Float
  roiPercent        Float
  score             Int
  checkedAt         DateTime @default(now())
  result            ArbitrageResultRecord @relation(fields: [arbitrageResultId], references: [id], onDelete: Cascade)

  @@index([arbitrageResultId, checkedAt])
}

model TrendyolCategoryMap {
  id                 String   @id @default(cuid())
  trendyolCategoryId String   @unique
  trendyolSlug       String
  trendyolLabel      String
  trendyolParentPath String?
  ebayCategoryId     String?
  ebayCategoryName   String?
  ebayFeeRate        Float?
  productCount       Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
  @@index([ebayCategoryId])
}

model ResearchCache {
  id        String   @id @default(cuid())
  userId    String
  cacheKey  String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, cacheKey])
  @@index([expiresAt])
}
