  transactionDate DateTime
  rawData         Json?
  syncedAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace, externalId])
  @@index([userId, marketplace, transactionDate])
  @@index([userId, barcode])
}

model FinancialSyncCursor {
  id              String   @id @default(cuid())
  userId          String
  marketplace     String
  lastSyncedTo    DateTime
  totalSynced     Int      @default(0)
  // Current marketplace account balance (Etsy: latest ledger balance) — money
  // earned but not yet disbursed to bank. Powers the "banked" panel.
  currentBalance  Decimal? @db.Decimal(12, 2)
  balanceCurrency String?
  // Funds the marketplace is holding (eBay exposes this via seller_funds_summary;
  // Etsy does not). Money earned but not available for payout yet.
  heldFunds       Decimal? @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace])
}

// ---------------------------------------------------------------------------
// Trendyol Product Cache (seller's own products synced from Trendyol API)
// ---------------------------------------------------------------------------

model TrendyolProduct {
  id         String @id @default(cuid())
  userId     String
  supplierId String

  // Trendyol identifiers
  barcode          String
  stockCode        String?
  productMainId    String?
  trendyolId       String? // Trendyol's internal product ID
  /// Public product id (trendyol.com/...-p-<id>): links the store's own orders to crowd market data (calibration).
  productContentId String?

  // Content
  title        String
  description  String? @db.Text
  brandId      Int?
  brandName    String?
  categoryId   Int?
  categoryName String?

  // Pricing
  listPrice    Decimal? @db.Decimal(10, 2)
  salePrice    Decimal? @db.Decimal(10, 2)
  currencyType String   @default("TRY")
  quantity     Int      @default(0)
  vatRate      Int?     @default(10)

  // Images (JSON array of {url})
  images       Json?
  thumbnailUrl String?
  imageCount   Int     @default(0)

  // Category attributes (JSON array of {attributeId, attributeValueId, customValue})
  attributes Json?

  // Status flags from Trendyol
  approved      Boolean @default(false)
  onSale        Boolean @default(false)
  rejected      Boolean @default(false)
  blacklisted   Boolean @default(false)
  archived      Boolean @default(false)
  rejectReasons Json?

  // Shipping
  dimensionalWeight Float?
  cargoCompanyId    Int?

  // Timestamps
  trendyolCreatedDate DateTime?
  trendyolLastUpdate  DateTime?
  syncedAt            DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthScore       Int?
  healthChecksUsed  Int      @default(0)
  healthChecksTotal Int      @default(0)
  healthFails       String[] @default([])

  @@unique([userId, supplierId, barcode])
  @@index([userId, supplierId])
  @@index([userId, onSale])
  @@index([userId, categoryId])
  @@index([supplierId, healthScore])
}

model WixSite {
  id              String    @id @default(cuid())
  userId          String
  siteId          String    @unique
  instanceId      String?
  siteName        String?
  siteUrl         String?
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  isActive        Boolean   @default(true)
  lastOrderSyncAt DateTime?
  /// Wix Stores catalog: "V1" | "V3" (null = not detected yet)
  catalogVersion  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User         @relation("UserWixSites", fields: [userId], references: [id], onDelete: Cascade)
  products WixProduct[] @relation("WixSiteProducts")

  @@unique([userId, siteId])
  @@index([userId])
}

model WixProduct {
  id           String  @id @default(cuid())
  userId       String
  wixSiteId    String
  wixProductId String
  slug         String?

  title         String
  description   String? @db.Text
  productType   String?
  brand         String?
  collectionIds Json?

  price         Decimal? @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("USD")

  trackInventory Boolean @default(true)
  inStock        Boolean @default(true)
  quantity       Int     @default(0)

  images       Json?
  thumbnailUrl String?
  imageCount   Int     @default(0)

  variants         Json?
  options          Json?
  customTextFields Json?

  visible Boolean @default(true)
  ribbon  String?
  weight  Float?
  sku     String?

  wixCreatedDate DateTime?
  wixUpdatedDate DateTime?
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site              WixSite  @relation("WixSiteProducts", fields: [wixSiteId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthScore       Int?
  healthChecksUsed  Int      @default(0)
  healthChecksTotal Int      @default(0)
  healthFails       String[] @default([])

  @@unique([userId, wixSiteId, wixProductId])
  @@index([userId, wixSiteId])
  @@index([wixSiteId, healthScore])
}

model ShopifyShop {
  id                String    @id @default(cuid())
  userId            String
  shopDomain        String    @unique // e.g. "mystore.myshopify.com"
  shopName          String?
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String?
  isActive          Boolean   @default(true)
  lastOrderSyncAt   DateTime?
  lastProductSyncAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User             @relation("UserShopifyShops", fields: [userId], references: [id], onDelete: Cascade)
  products ShopifyProduct[] @relation("ShopifyShopProducts")

  @@unique([userId, shopDomain])
  @@index([userId])
}

model ShopifyProduct {
  id               String @id @default(cuid())
  userId           String
  shopifyShopId    String
  shopifyProductId String // Shopify's product numeric ID as string

  // Content
  title       String
  description String?  @db.Text
  vendor      String?
  productType String?
  status      String? // active, draft, archived
  tags        String[]
  handle      String?

  // Pricing (from default variant)
  price          Decimal? @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  currency       String   @default("USD")

  // Inventory
  trackInventory Boolean @default(true)
  totalInventory Int     @default(0)

  // Images (JSON array of {id, src, alt, position})
  images       Json?
  thumbnailUrl String?
  imageCount   Int     @default(0)

  // Variants (JSON array of variant objects)
  variants     Json?
  options      Json?
  variantCount Int   @default(0)

  // SEO
  seoTitle       String?
  seoDescription String?

  // Shopify timestamps
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?
  syncedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop              ShopifyShop @relation("ShopifyShopProducts", fields: [shopifyShopId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthScore       Int?
  healthChecksUsed  Int         @default(0)
  healthChecksTotal Int         @default(0)
  healthFails       String[]    @default([])

  @@unique([userId, shopifyShopId, shopifyProductId])
  @@index([userId, shopifyShopId])
  @@index([shopifyShopId, status])
  @@index([shopifyShopId, healthScore])
}

// ---------------------------------------------------------------------------
// Amazon Research & Tracking Models
// ---------------------------------------------------------------------------

model AmazonTrackedProduct {
  id            String    @id @default(cuid())
  userId        String
  asin          String
  title         String?
  imageUrl      String?
  categoryId    String?
  categoryName  String?
  seller        String?
  currentPrice  Float?
  currency      String    @default("USD")
  currentRank   Int?
  reviewCount   Int?
  rating        Float?
  notes         String?
  tags          String[]
  isActive      Boolean   @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  snapshots AmazonPriceSnapshot[]
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asin])
  @@index([userId, isActive])
}

model AmazonPriceSnapshot {
  id               String   @id @default(cuid())
  trackedProductId String
  userId           String
  price            Float?
  currency         String   @default("USD")
  salesRank        Int?
  reviewCount      Int?
  rating           Float?
  timestamp        DateTime @default(now())

  trackedProduct AmazonTrackedProduct @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trackedProductId])
  @@index([trackedProductId, timestamp])
  @@index([userId])
}

model AmazonNicheResearch {
  id               String   @id @default(cuid())
  userId           String
  query            String
  categoryId       String?
  categoryName     String?
  marketplace      String   @default("amazon.com")
  totalResults     Int?
  avgPrice         Float?
  medianPrice      Float?
  avgReviews       Int?
  avgRating        Float?
  demandScore      Float?
  competitionScore Float?
  notes            String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use auth tokens for email verification and password reset.
/// Distinct from NextAuth's VerificationToken (which is for the Email provider —
/// not wired in this project). Tokens here are stored as SHA-256 hashes; the
/// plaintext lives only in the URL we email to the user. Once `consumedAt` is
/// set or `expires` passes, the row is dead.
model AuthToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  /// Lowercased email of the account this token concerns.
  identifier String
  /// 'email_verify' | 'password_reset'.
  purpose    String
  expires    DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
  @@index([purpose, expires])
}

/// Single-row-per-(jobName, bucket) lock to deduplicate cron triggers.
/// Used by lib/cron/idempotency.ts. Inserted on entry, never updated.
/// Old rows can be pruned with a simple createdAt cutoff; not done automatically.
model CronLock {
  id        String   @id @default(cuid())
  jobName   String
  bucket    String
  createdAt DateTime @default(now())

  @@unique([jobName, bucket])
  @@index([jobName, bucket])
  @@index([createdAt])
}

/// Append-only snapshots of PUBLIC Etsy listing/shop counters, written whenever
/// any user views a listing through the Chrome extension (/api/ext/listing-stats).
/// Real sales velocity = delta of shopSoldCount between two snapshots of the same
/// shop. Counter columns come from the Etsy public API only (trusted); the page*
/// columns are what the viewer's browser scraped from the listing page and are
/// display-only — never used for velocity math because clients can forge them.
model EtsyPublicListingSnapshot {
  id                 String   @id @default(cuid())
  listingId          String
  shopId             String
  /// Shop transaction_sold_count at capture time (Etsy API).
  shopSoldCount      Int?
  /// Shop review_count at capture time (Etsy API).
  shopReviewCount    Int?
  /// Listing num_favorers (Etsy API).
  listingFavorites   Int?
  /// Listing review count (Etsy API /listings/{id}/reviews count).
  listingReviewCount Int?
  /// Listing views (Etsy API; may be absent).
  listingViews       Int?
  price              Float?
  currency           String?
  /// Page-scraped "N people bought this in the last 24 hours" (untrusted, display only).
  pageBoughtLast24h  Int?
  /// Page-scraped "In N carts" (untrusted, display only).
  pageInCarts        Int?
  capturedAt         DateTime @default(now())

  @@index([listingId, capturedAt])
  @@index([shopId, capturedAt])
  @@index([capturedAt])
}

/// In-app notification (bell). Text is rendered client-side via next-intl:
/// t(titleKey, params) under the 'notifications' namespace.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  severity   String // 'info' | 'warning' | 'error'
  titleKey   String
  params     Json?
  link       String?
  dedupeKey  String?
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---- Notification center v2 (W5) ----
  entityType String?
  entityId   String?
  /// false = activity feed only (no unread badge)
  badge      Boolean                @default(true)
  raiseCount Int                    @default(0)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([userId, badge, readAt, resolvedAt])
  @@index([type, createdAt])
}

/// Outbox for out-of-app deliveries (email, telegram) of a notification raise.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  channel        String // email | telegram
  raiseSeq       Int          @default(0)
  status         String       @default("pending") // pending | held | digest | sent | failed | skipped
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  error          String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, raiseSeq])
  @@index([status, nextAttemptAt])
}

/// Per-type channel preferences. type = NotificationType or '*'.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  type      String
  inApp     Boolean  @default(true)
  email     Boolean  @default(false)
  telegram  Boolean  @default(false)
  emailMode String   @default("instant") // instant | digest
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Per-user notification settings (one row per user).
model NotificationSettings {
  userId           String    @id
  locale           String?
  timezone         String    @default("Europe/Istanbul")
  preset           String    @default("recommended") // critical | recommended | all | custom
  emailEnabled     Boolean   @default(true)
  quietHoursStart  Int?      @default(23)
  quietHoursEnd    Int?      @default(8)
  digestHour       Int       @default(8)
  lastDigestAt     DateTime?
  telegramChatId   String?
  telegramLinkedAt DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Stock sync (W2). Ships disabled: nothing writes stock to any marketplace
// until the seller completes the wizard and presses Go Live.
// ============================================================================

model StockSettings {
  userId               String    @id
  enabled              Boolean   @default(false)
  dryRun               Boolean   @default(true)
  enabledAt            DateTime?
  goLiveAt             DateTime?
  restockOnCancel      Boolean   @default(true)
  /// lower-only automatic drift fixes
  autoFixDrift         Boolean   @default(false)
  etsyZeroStockAction  String    @default("disable_variation")
  seedPolicy           String    @default("min")
  seedSubtractReserved Boolean   @default(true)
  channels             String[]  @default([])
  shopifyLocationId    String?
  orderScanCursorAt    DateTime?
  orderScanCursorId    String?
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockItem {
  id           String        @id @default(cuid())
  userId       String
  /// normalizeSku() output
  sku          String
  displaySku   String
  title        String?
  imageUrl     String?
  onHand       Int           @default(0)
  safetyBuffer Int           @default(0)
  tracking     String        @default("tracked") // tracked | untracked
  status       String        @default("active") // active | paused | needs_review
  seededAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  links        StockLink[]
  ledger       StockLedger[]
  pushes       StockPush[]

  @@unique([userId, sku])
  @@index([userId, status])
}

model StockLink {
  id                    String    @id @default(cuid())
  userId                String
  stockItemId           String
  channel               String
  accountRef            String
  /// etsy listingId | ebay sku/offer | trendyol barcode | shopify productId | wix productId | amazon sellerSku
  externalId            String
  /// etsy variantKey | shopify inventory_item_id | wix variantId
  variantRef            String    @default("")
  variantValueKey       String?
  locationRef           String?
  remoteSku             String?
  title                 String?
  matchType             String    @default("auto_exact") // auto_exact | suggested_loose | manual
  status                String    @default("suggested") // suggested | active | paused | error | unsupported
  statusReason          String?
  unitsPerSale          Int       @default(1)
  buffer                Int       @default(0)
  maxListedQty          Int?
  lastSeenRemoteQty     Int?
  lastSeenRemoteTs      Int?
  lastSeenAt            DateTime?
  unattributedDrop      Int       @default(0)
  unattributedDropSince DateTime?
  deactivatedByStock    Boolean   @default(false)
  deactivatedAt         DateTime?
  lastPushedQty         Int?
  lastPushedAt          DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  stockItem             StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, accountRef, externalId, variantRef])
  @@index([stockItemId])
  @@index([userId, channel, status])
  @@index([channel, accountRef, externalId])
}

model StockLedger {
  id             String    @id @default(cuid())
  userId         String
  stockItemId    String
  /// seed | sale | sale_adjust | cancel | manual_adjust | remote_adjust | drift_fix
  kind           String
  delta          Int
  qtyAfter       Int
  channel        String?
  linkId         String?
  orderId        String?
  orderKey       String?
  idempotencyKey String    @unique
  sourceEventId  String?
  actor          String    @default("system")
  note           String?
  createdAt      DateTime  @default(now())
  stockItem      StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([stockItemId, createdAt])
  @@index([orderKey, stockItemId])
}

model StockPush {
  id             String    @id @default(cuid())
  userId         String
  stockItemId    String
  linkId         String
  /// = linkId while pending, else null
  pendingKey     String?   @unique
  /// sale | cancel | adjust | remote_adjust | reconcile | manual | seed | restore
  reason         String
  targetQty      Int
  freshRemoteQty Int?
  sentQty        Int?
  /// pending | in_flight | unknown | awaiting_batch | applied | skipped | failed | dry_run | superseded
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  claimedAt      DateTime?
  appliedAt      DateTime?
  remoteQtyAfter Int?
  externalRef    String?
  lastError      String?
  ledgerId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  stockItem      StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([linkId, status])
  @@index([userId, createdAt])
}

model StockObservation {
  id              String   @id @default(cuid())
  userId          String
  linkId          String
  stockItemId     String?
  remoteQty       Int
  prevSeenQty     Int?
  delta           Int?
  /// echo | baseline | expected | unattributed_drop | increase_alert | stale_ignored | deferred
  kind            String
  source          String
  eventId         String?
  remoteUpdatedTs Int?
  createdAt       DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([userId, createdAt])
}

model StockSnapshot {
  id         String    @id @default(cuid())
  userId     String
  reason     String    @default("go_live")
  takenAt    DateTime  @default(now())
  expiresAt  DateTime
  /// [{linkId, remoteQty}]
  data       Json
  restoredAt DateTime?

  @@index([userId, takenAt])
}

/// Unified inbox cache + read state (design/surfaces/messages.md §6.2). One row per Wix conversation or
/// Trendyol question; written by lib/messages/inboxCache.ts (DbInboxStore).
model InboxThread {
  id                String    @id @default(cuid())
  userId            String
  platform          String // 'wix' | 'trendyol'
  externalId        String // Wix conversationId | Trendyol questionId
  contactId         String?
  customerName      String?
  lastMessageAt     DateTime?
  lastMessageText   String?   @db.Text // first 280 chars
  lastFromCustomer  Boolean?
  needsReply        Boolean   @default(false)
  messageCount      Int? // Wix: 0 => hidden from the list (D4)
  contactActivityAt DateTime? // Wix contact.lastActivity when the cache row was refreshed
  lastOrderNumber   String?
  lastSeenAt        DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalId])
  @@index([userId, needsReply, lastMessageAt])
}

/// Consecutive auth failures per marketplace connection (lib/integrations/authFailures.ts).
/// accountId = the connection's user-facing id (Shopify shop domain, Trendyol supplier id,
/// Amazon seller id). After AUTH_FAILURE_THRESHOLD consecutive 401/403/invalid_grant/token
/// refresh failures `needsReconnect` is set: sync skips the connection and Settings shows
/// Reconnect until a successful auth or a reconnect / credential re-save deletes the row.
model ConnectionAuthState {
  id                  String    @id @default(cuid())
  userId              String
  provider            String
  accountId           String
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  lastError           String?
  needsReconnect      Boolean   @default(false)
  needsReconnectAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountId])
  @@index([userId, needsReconnect])
}

/// Saved replies for Messages (design/surfaces/messages.md §6.4); read/written by
/// pages/api/messages/saved-replies.ts. Replaces the per-browser localStorage list.
model SavedReply {
  id         String   @id @default(cuid())
  userId     String
  title      String // <= 60
  body       String   @db.Text // <= 1000
  platform   String? // null = all stores
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
  @@index([userId, usageCount])
}

/// Seller's standing instructions for every AI feature (founder 2026-10-17: "users enter their own preferences so
/// AI generates results according to those criteria"). marketplace = 'all' (defaults) or etsy/ebay/trendyol/wix/
/// shopify/amazon (overrides). Injected by lib/ai into every prompt; marketplace rules still win.
model AiPreference {
  id          String   @id @default(cuid())
  userId      String
  marketplace String   @default("all")
  /// e.g. "warm and friendly", "luxury", "short and factual"
  tone        String?
  /// words / facts to always use ("handmade", "made in Turkey")
  include     String[] @default([])
  /// words never to use ("cheap", competitor brands)
  avoid       String[] @default([])
  brand       String?
  /// free text, ≤ 1000 chars
  notes       String?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace])
}

/// One row per AI call (lib/ai): cost tracking and the base for AI credit enforcement.
model AiUsage {
  id             String   @id @default(cuid())
  userId         String?
  feature        String
  model          String
  ok             Boolean  @default(true)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  thinkingTokens Int      @default(0)
  images         Int      @default(0)
  ms             Int      @default(0)
  refine         Boolean  @default(false)
  error          String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

/// One AI product video (Veo). Long-running: started, then polled until done; the mp4 is stored on the VPS
/// (uploads/ai-videos/<userId>/<id>.mp4). A follow-up ("slower camera") is a new job with parentId. provider =
/// 'gemini' (API key) or 'vertex' (Google Cloud project, needed for photos with child models — allowlisted).
model AiVideoJob {
  id            String   @id @default(cuid())
  userId        String
  parentId      String?
  provider      String   @default("gemini")
  model         String
  status        String   @default("running") // running | done | failed
  prompt        String
  instruction   String?
  sourceUrl     String?
  aspectRatio   String   @default("9:16")
  durationSec   Int      @default(8)
  operation     String?
  filePath      String?
  errorKey      String?
  errorDetail   String?
  /// Video Studio: image | interpolate | reference | extend | edit
  mode          String   @default("image")
  /// lib/ai/videoDirector VideoDirection (preset, camera, expression, scene, …)
  direction     Json?
  /// last frame + reference images (https urls or studio-upload:<id>)
  endUrl        String?
  referenceUrls String[] @default([])
  resolution    String   @default("720p")
  quality       String   @default("fast")
  seed          Int?
  /// one generation with N variants shares a groupId; variantIndex 0..N-1
  groupId       String?
  variantIndex  Int      @default(0)
  favorite      Boolean  @default(false)
  /// listing it was made for: "<marketplace>:<listingId>[:<storeId>]" + its title
  listingRef    String?
  title         String?
  /// AI kredisi charged for this request (lib/billing/aiCredits); refunded when Veo fails
  credits       Int      @default(0)
  /// Quality check after generation (lib/ai/videoProduct checkVideo): { status, match, realism, diffs, issues }
  qa            Json?
  /// Sent to marketplace listings (lib/ai/videoPublish): { [marketplace]: { status, listingId, remoteId, error, at } }
  published     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([groupId])
}

/// AI kredisi ledger (image + video generation). Balance = this month's plan allowance minus plan-bucket spend,
/// plus the pack bucket (purchased credits, never expire). lib/billing/aiCreditsServer.ts.
model AiCreditEntry {
  id        String   @id @default(cuid())
  userId    String
  /// − spend, + refund / purchase / adjust
  delta     Int
  /// spend | refund | purchase | adjust
  kind      String
  /// plan (the month's allowance) | pack (purchased)
  bucket    String
  /// plan bucket: calendar month (UTC) "2026-10"
  period    String?
  /// video | image | pack id
  feature   String?
  /// idempotency: job id, Stripe checkout session id, Shopify purchase id
  ref       String?
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, bucket, ref])
  @@index([userId, createdAt])
  @@index([userId, bucket, period])
}

/// "Connect your own AI" (MCP, /api/mcp): one AI client a seller connected (Claude, ChatGPT, Cursor …).
/// Tokens are stored as SHA-256 hashes only; every tool call is scoped to `userId`. lib/mcp/*.
model AiConnection {
  id          String    @id @default(cuid())
  userId      String
  /// The client's name (OAuth client_name) or the seller's label for a personal key
  name        String
  /// oauth | token
  kind        String
  clientId    String?
  tokenHash   String    @unique
  /// First characters of the token, to recognise it in the list
  tokenPrefix String
  refreshHash String?   @unique
  /// read | write (write = staged drafts only, never a direct marketplace change)
  scopes      String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// OAuth 2.1 public clients registered dynamically (RFC 7591) by AI apps connecting to /api/mcp.
model McpOAuthClient {
  id           String   @id
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
}

/// One-time authorization codes (PKCE S256), 10 minutes.
model McpOAuthCode {
  codeHash      String    @id
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scopes        String[]
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// Hepsiburada listing cache (listing-external `listings` joined with catalog `all-products-of-merchant` for
/// title/images/barcode). Refreshed by the hepsiburada-listings job and the listings "Pull" action.
model HepsiburadaListing {
  id          String  @id @default(cuid())
  userId      String
  merchantId  String
  hbSku       String
  merchantSku String?
  listingId   String?
  productId   String?
  barcode     String?

  title        String?
  brand        String?
  categoryId   Int?
  categoryName String?
  images       Json?
  thumbnailUrl String?

  price                      Decimal? @db.Decimal(12, 2)
  availableStock             Int      @default(0)
  dispatchTime               Int?
  maximumPurchasableQuantity Int?
  cargoCompanies             String[] @default([])
  isSalable                  Boolean  @default(false)
  isSuspended                Boolean  @default(false)
  isLocked                   Boolean  @default(false)
  isFrozen                   Boolean  @default(false)
  /// Stock owned by HB's warehouse: never pushed.
  isFulfilledByHB            Boolean  @default(false)
  deactivationReasons        String[] @default([])
  raw                        Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId, hbSku])
  @@index([userId, merchantId])
  @@index([userId, merchantSku])
  @@index([userId, barcode])
}

/// Async Hepsiburada uploads (price/stock/inventory uploads, product import/update tickets) we still have to
/// resolve. `source` says who is waiting for the result (stock push, catalog draft, editor).
model HepsiburadaUploadBatch {
  id         String    @id @default(cuid())
  userId     String
  merchantId String
  kind       String // inventory | stock | price | import | update
  uploadId   String
  status     String    @default("pending") // pending | done | failed
  source     String? // stock | catalogDraft | editor | bulk
  sourceRef  String?
  itemCount  Int       @default(0)
  items      Json?
  errors     Json?
  attempts   Int       @default(0)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, kind, uploadId])
  @@index([status, createdAt])
  @@index([userId, status])
}

/// Native app push targets (App Store app: APNs device tokens). lib/push/apns.ts, channel 'push'.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  platform   String // ios
  token      String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Crowd market data (Trendyol, Hepsiburada): public product facts read by the KolayXport extension from pages
/// sellers open in their own browser, shared by everyone. Rows never carry a userId (lib/market/ingest.ts).
/// One row per marketplace product: the latest known state.
model MarketProduct {
  id               String   @id @default(cuid())
  mkt              String // trendyol | hepsiburada
  productId        String
  title            String
  brand            String?
  sellerId         String?
  sellerName       String?
  categoryId       String?
  categoryName     String?
  url              String?
  imageUrl         String?
  price            Float?
  currency         String   @default("TRY")
  rating           Float?
  ratingCount      Int?
  reviewCount      Int?
  favorites        Int?
  otherSellerCount Int?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@unique([mkt, productId])
  @@index([mkt, sellerId])
  @@index([mkt, categoryId])
  @@index([lastSeenAt])
}

/// Time series of a product's public counters, at most one row per product per hour (sales = deltas).
model MarketProductObservation {
  id               String   @id @default(cuid())
  mkt              String
  productId        String
  hourBucket       DateTime
  observedAt       DateTime @default(now())
  source           String // search | product | store
  price            Float?
  originalPrice    Float?
  rating           Float?
  ratingCount      Int?
  reviewCount      Int?
  favorites        Int?
  basketCount      Int?
  viewCount        Int?
  orderBadge       String?
  ordersAtLeast    Int?
  otherSellerCount Int?
  buyboxSellerId   String?
  /// Product page buybox: [{ sellerId, name, price, score }] as shown.
  offers           Json?

  @@unique([mkt, productId, hourBucket])
  @@index([mkt, productId, observedAt])
  @@index([observedAt])
}

/// A search/category page as seen: total and the ordered organic + sponsored product ids (ranks, SEO, ad share).
model MarketSearchObservation {
  id           String   @id @default(cuid())
  mkt          String
  queryKey     String // normalized query, or "c:<categoryId>" for category pages
  query        String
  hourBucket   DateTime
  observedAt   DateTime @default(now())
  total        Int?
  page         Int      @default(1)
  organicIds   Json
  sponsoredIds Json

  @@unique([mkt, queryKey, page, hourBucket])
  @@index([mkt, queryKey, observedAt])
  @@index([observedAt])
}

/// Store (seller) facts as seen on store/product pages.
model MarketSeller {
  id           String   @id @default(cuid())
  mkt          String
  sellerId     String
  name         String?
  score        Float?
  followers    Int?
  productCount Int?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([mkt, sellerId])
}

/// Who contributed how much (give-to-get, rate limits, "you added N products"). Separate from the data rows.
model MarketContribution {
  id       String   @id @default(cuid())
  userId   String
  day      DateTime @db.Date
  mkt      String
  products Int      @default(0)
  pages    Int      @default(0)

  @@unique([userId, day, mkt])
}

/// Reader health per extension parser version: accepted vs rejected pages (Trendyol page changes show up here).
model MarketIngestStat {
  id            String   @id @default(cuid())
  day           DateTime @db.Date
  mkt           String
  pageType      String
  parserVersion String
  accepted      Int      @default(0)
  rejected      Int      @default(0)

  @@unique([day, mkt, pageType, parserVersion])
}

/// Referral partners (docs/gtm/referral-spec.md, docs/gtm/turkey-gameplan.md §4.2).
model Partner {
  id                  String              @id @default(uuid())
  /// Upper case A–Z, 0–9, '-', 3–20 chars, e.g. "ETSYILEGELIR".
  code                String              @unique
  name                String
  /// fb_admin | tg_admin | x_voice | youtube | musavir | other
  type                String
  /// For statements; never shown to anyone else.
  email               String?
  /// active | paused | terminated
  status              String              @default("active")
  rate                Decimal             @default(0.30) @db.Decimal(5, 4)
  tierRate            Decimal             @default(0.35) @db.Decimal(5, 4)
  /// Distinct paying referred customers before tierRate applies.
  tierThreshold       Int                 @default(10)
  /// Commission window in months from the customer's first payment.
  months              Int                 @default(12)
  /// Stripe promotion_code id (promo_...).
  stripePromotionCode String?             @unique
  /// The code customers type, usually == code.
  promoCodeText       String?
  notes               String?
  /// The partner's own KolayXport login (partner dashboard /app/ortaklik). Linked by an admin.
  userId              String?             @unique
  /// Stripe Global Payouts recipient (Tamsar, Inc. account). Bank details live at Stripe, never here.
  stripeRecipientId   String?
  createdAt           DateTime            @default(now())
  acquisitions        UserAcquisition[]
  commissions         PartnerCommission[]
}

/// First-touch signup attribution: one row per user, written once (signup, post-login claim, or promo code).
model UserAcquisition {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  /// First landing path.
  landing     String?
  /// Raw ?ref= value as captured (upper-cased, format-checked).
  refCode     String?
  /// Set only when refCode / promo code matches an active, eligible Partner.
  partnerId   String?
  partner     Partner?  @relation(fields: [partnerId], references: [id])
  /// signup | claim | promo
  via         String
  /// When the first-touch cookie was set.
  firstSeenAt DateTime?
  capturedAt  DateTime  @default(now())

  @@index([partnerId])
}

/// Partner commission ledger (Stage B: written from Stripe webhooks).
model PartnerCommission {
  id              String   @id @default(uuid())
  partnerId       String
  partner         Partner  @relation(fields: [partnerId], references: [id])
  userId          String
  /// Invoice id (in_...), checkout session id (cs_...) for credit packs, refund id (re_...).
  stripeObjectId  String   @unique
  /// bounty_year | bounty_month | bounty_upgrade | reversal
  kind            String
  /// stripe | iyzico | paytr
  provider        String   @default("stripe")
  /// Human-readable rule that produced the row (e.g. "year 25%", "month 2nd payment", "refund re_...").
  reason          String?
  /// Bounty before any partial refund; commissionMinor is reduced from it.
  earnedMinor     Int?
  paidAt          DateTime
  /// try | usd
  currency        String
  grossMinor      Int
  taxMinor        Int
  netMinor        Int
  rate            Decimal  @db.Decimal(5, 4)
  commissionMinor Int
  /// pending | payable | paid | void
  status          String   @default("pending")
  payableAt       DateTime
  payoutId        String?
  createdAt       DateTime @default(now())

  @@index([partnerId, status])
}

/// Monthly partner payouts (EFT in TRY).
model PartnerPayout {
  id          String    @id @default(uuid())
  partnerId   String
  /// "2026-12"
  period      String
  amountMinor Int
  currency    String
  fxNote      String?
  paidAt      DateTime?
  reference   String?
  /// stripe_global | manual
  provider    String    @default("manual")
  /// Stripe outbound payment id, or the bank reference for manual payouts.
  externalId  String?
  /// created | sent | paid | failed
  status      String    @default("created")
  error       String?
  createdAt   DateTime  @default(now())

  @@index([partnerId])
}

/// Subscription payments of partner-referred customers (lib/partners/bounty.ts). Lets the bounty rules tell a first
/// payment from a second / renewal / upgrade the same way for every provider. Only attributed users get rows.
model PartnerPaymentEvent {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  /// Provider object id (Stripe invoice in_..., iyzico/PayTR order id). Unique, so replays are no-ops.
  objectId   String   @unique
  /// month | year
  interval   String
  planKey    String?
  paidAt     DateTime
  currency   String
  grossMinor Int
  netMinor   Int
  createdAt  DateTime @default(now())

  @@index([userId, paidAt])
}

/// Pricing v2 module add-ons per account (docs/gtm/pricing-v2.md §3, lib/billing/modules.ts). One row per module;
/// `quantity` counts extra stores / +orders units. Granted by an admin today; by Stripe / iyzico / PayTR once P2–P3
/// exist (provider + externalId then point at the subscription item / order).
model BillingModule {
  id               String    @id @default(uuid())
  userId           String
  /// financials | arbitrage | bulkPhotoStudio | extraStore | extraOrders
  module           String
  quantity         Int       @default(1)
  /// active | canceled
  status           String    @default("active")
  /// admin | stripe | iyzico | paytr
  provider         String    @default("admin")
  externalId       String?
  /// null = no end (admin grant); otherwise the module ends after this time.
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

/// EU customs product identifiers a seller confirmed on a label (lib/shipping/productIds.ts), reused for the next
/// order of the same product. `key` is "sku:<SKU>" or "listing:<listing id>".
model ProductIdentifier {
  id           String   @id @default(cuid())
  userId       String
  key          String
  merchant     String
  manufacturer String
  /// Valid GTIN / EAN / UPC, or "" (sent as NA).
  gtin         String   @default("")
  updatedAt    DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

/// Onboarding reminder emails to signups who haven't connected a store yet (lib/activation/emails.ts). One row per sent step.
model ActivationEmail {
  id     String   @id @default(cuid())
  userId String
  step   String // day1 | day4
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, step])
  @@index([userId])
}
