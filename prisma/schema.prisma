generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id                      String                   @id
  name                    String?
  email                   String?                  @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  googleAccountId         String?                  @unique
  googleSheetId           String?                  @unique
  driveFolderId           String?
  userAppsScriptId        String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastSyncedAt            DateTime?
  onboardingStep          Int?                     @default(0)
  shippingSettings        Json?
  billingInterval         String?
  labelCount              Int                      @default(0)
  orderSyncCount          Int                      @default(0)
  stripeCustomerId        String?                  @unique
  subscriptionPlan        String?
  subscriptionStatus      String?
  billingProvider         String? // 'stripe' | 'shopify'
  shopifySubscriptionId   String?                  @unique
  trialExpiresAt          DateTime?
  usageResetAt            DateTime?
  role                    String                   @default("user")
  accounts                Account[]
  marketplaceConfigs      MarketplaceConfig[]
  orders                  Order[]
  products                Product[]
  sessions                Session[]
  shipperProfile          ShipperProfile?
  syncLogs                SyncLog[]
  syncOperations          SyncOperation[]
  integrationSettings     Credential?
  etsyAddresses           EtsyAddress[]
  trackingSubmissions     TrackingSubmission[]     @relation("UserTrackingSubmissions")
  senkronOrderData        SenkronOrderData[]       @relation("UserSenkronData")
  etsyShops               EtsyShop[]               @relation("UserEtsyShops")
  ebayTrackedProducts     EbayTrackedProduct[]
  ebayTrackedSellers      EbayTrackedSeller[]
  ebayNicheResearch       EbayNicheResearch[]
  rankTrackedKeywords     RankTrackedKeyword[]
  arbitrageScanJobs       ArbitrageScanJob[]
  arbitrageResults        ArbitrageResultRecord[]
  productCosts            ProductCost[]
  financialTransactions   FinancialTransaction[]
  financialSyncCursors    FinancialSyncCursor[]
  trendyolProducts        TrendyolProduct[]
  hepsiburadaListings     HepsiburadaListing[]
  wixSites                WixSite[]                @relation("UserWixSites")
  wixProducts             WixProduct[]
  shopifyShops            ShopifyShop[]            @relation("UserShopifyShops")
  connectionAuthStates    ConnectionAuthState[]
  shopifyProducts         ShopifyProduct[]
  amazonTrackedProducts   AmazonTrackedProduct[]
  amazonPriceSnapshots    AmazonPriceSnapshot[]
  amazonNicheResearch     AmazonNicheResearch[]
  etsyListingDrafts       EtsyListingDraft[]
  ebayListingDrafts       EbayListingDraft[]
  catalogDrafts           CatalogDraft[]
  ebayListings            EbayListing[]
  adminAuditLogs          AdminAuditLog[]          @relation("AdminAuditLogs")
  notifications           Notification[]
  inboxThreads            InboxThread[]
  savedReplies            SavedReply[]
  researchWatches         ResearchWatch[]
  notificationPreferences NotificationPreference[]
  aiPreferences           AiPreference[]
  aiUsage                 AiUsage[]
  aiVideoJobs             AiVideoJob[]
  aiCreditEntries         AiCreditEntry[]
  aiConnections           AiConnection[]
  notificationSettings    NotificationSettings?
  activationEmails        ActivationEmail[]
  pushDevices             PushDevice[]
  acquisition             UserAcquisition?
  stockSettings           StockSettings?
  stockItems              StockItem[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MarketplaceConfig {
  id        String   @id @default(cuid())
  userId    String
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                          String               @id @default(cuid())
  userId                      String
  marketplace                 String
  marketplaceKey              String
  customerName                String?
  status                      String?
  currency                    String?
  totalPrice                  Float?
  // Actual carrier cost for this order's shipment, entered manually from the
  // carrier invoice (UPS/MNG bill later; label API responses don't carry the
  // final cost). Feeds the financial dashboard's shipping bucket.
  manualShippingCost          Decimal?             @db.Decimal(10, 2)
  manualShippingCostCurrency  String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  orderNumber                 String
  shippingAddress             Json?
  rawData                     Json?
  labelStatus                 String?
  commodityDesc               String?
  countryOfMfg                String?
  dimensionUnits              String?
  fedexDutiesPaymentType      String?
  fedexPackagingType          String?
  fedexPickupType             String?
  fedexServiceType            String?
  harmonizedCode              String?
  labelStockType              String?
  packageHeight               Float?
  packageLength               Float?
  packageWidth                Float?
  sendCommercialInvoiceViaEtd Boolean?             @default(true)
  shipmentStatus              String?
  shippedAt                   DateTime?
  shippingChargesPaymentType  String?
  shippingLabelUrl            String?
  signatureType               String?
  termsOfSale                 String?              @default("DDU")
  trackingNumber              String?
  weightKg                    Float?               @default(0.5)
  externalStatus              String?
  uiOrderDate                 DateTime?
  // Marks when the user manually edited weight/dimensions on this order.
  // Sync should skip overwriting weight-related fields when this is non-null.
  weightEditedAt              DateTime?
  // Buyer-provided gift message captured from marketplace (e.g. Etsy gift_message).
  giftMessage                 String?
  // Buyer-provided personalization / notes captured from marketplace
  // (e.g. Etsy message_from_buyer). Surfaced on the labels page detail view.
  customerNote                String?
  // When a Trendyol cargo label (PDF/ZPL) was last downloaded for this order (bulk or single). Bulk printing skips
  // orders where this is set. Not a sync field: the Trendyol sync never writes it (labelStatus is reset by sync).
  cargoLabelPrintedAt         DateTime?
  items                       OrderItem[]          @relation("OrderToOrderItem")
  user                        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments                   Shipment[]           @relation("OrderToShipment")
  shipping                    OrderShipping?       @relation("OrderToOrderShipping")
  trackingSubmissions         TrackingSubmission[] @relation("OrderTrackingSubmissions")
  senkronData                 SenkronOrderData?    @relation("OrderSenkronData")

  // ---- Order lifecycle (W4) ----
  /// etsy-api | ebay-api | trendyol | shopify | wix | amazon | veeqo | shippo | ...
  source             String?
  cancelledAt        DateTime?
  deliveredAt        DateTime?
  shipByAt           DateTime?
  shippedLate        Boolean?
  returnWindowEndsAt DateTime?
  orderHash          String?
  itemsHash          String?
  lastEventAt        DateTime?
  lastRemoteCheckAt  DateTime?
  effects            OrderEffect[]

  @@unique([userId, marketplace, marketplaceKey])
  @@index([userId])
  @@index([marketplace, marketplaceKey])
  @@index([userId, labelStatus])
  @@index([userId, createdAt])
  @@index([userId, externalStatus])
  @@index([userId, marketplace])
  @@index([userId, uiOrderDate])
  @@index([userId, status, shipByAt])
  @@index([userId, shippedAt])
  @@index([userId, source])
  @@index([userId, updatedAt, id])
}

/// Transactional outbox of order side effects, unique per (orderId, effect).
model OrderEffect {
  id            String    @id @default(cuid())
  orderId       String
  /// e.g. notify_new | stock_apply:<itemsHash>:<statusClass> | close_tracking_cancelled |
  /// cancel_label_alert | close_tracking_shipped | shipped_external | delivered_metrics
  effect        String
  status        String    @default("pending") // pending | done | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  payload       Json?
  createdAt     DateTime  @default(now())
  doneAt        DateTime?
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, effect])
  @@index([status, nextAttemptAt])
}

model OrderItem {
  id              String     @id @default(cuid())
  orderId         String
  sku             String?
  productName     String?
  variantInfo     String?
  quantity        Int        @default(1)
  unitPrice       Decimal?   @db.Decimal(10, 2)
  totalPrice      Decimal?   @db.Decimal(10, 2)
  notes           String?
  image           String     @default("")
  marketplaceKey  String?
  shipBy          DateTime?
  orderNumber     String?
  uniqueLineKey   String?
  productId       String?
  remoteLineId    String?
  countryOfMfg    String?
  harmonizedCode  String?
  weightKg        Float?     @default(0.5)
  // Marks when the user manually edited this item's weight. When set, the
  // order sync writer must not overwrite weightKg from marketplace rawData.
  weightEditedAt  DateTime?
  recipientEmail  String?    @map("recipient_email")
  /// Etsy listing_id / eBay item id / channel listing id
  listingRef      String?
  /// Etsy variantKey / Shopify variant id / Wix variantId
  variantRef      String?
  variantValueKey String?
  labelJobs       LabelJob[]
  order           Order      @relation("OrderToOrderItem", fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?   @relation(fields: [productId], references: [id])
  shipments       Shipment[]

  @@unique([remoteLineId, orderId], name: "remoteLineId_orderId")
  @@index([orderId])
  @@index([sku])
  @@index([orderId, sku])
  @@index([listingRef])
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String
  name                String
  description         String?
  price               Decimal              @db.Decimal(10, 2)
  cost                Decimal?             @db.Decimal(10, 2)
  weight              Float?
  dimensions          Json?
  imageUrl            String?
  active              Boolean              @default(true)
  userId              String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  countryOfMfg        String?
  harmonizedCode      String?
  inventories         Inventory[]
  marketplaceProducts MarketplaceProduct[]
  orderItems          OrderItem[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
}

model Inventory {
  id           String   @id @default(cuid())
  productId    String
  location     String   @default("default")
  quantity     Int      @default(0)
  reorderLevel Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
}

model MarketplaceProduct {
  id              String   @id @default(cuid())
  productId       String
  marketplace     String
  marketplaceId   String
  marketplaceData Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([marketplace, marketplaceId])
}

model Credential {
  id                    String    @id @default(cuid())
  userId                String    @unique
  veeqoApiKey           String?
  shippoToken           String?
  fedexApiKey           String?
  fedexApiSecret        String?
  fedexAccountNumber    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  fedexMeterNumber      String?
  hepsiburadaApiKey     String?
  hepsiburadaMerchantId String?
  trendyolApiKey        String?
  trendyolApiSecret     String?
  trendyolSupplierId    String?
  upsAccountNumber      String?
  upsApiKey             String?
  upsApiSecret          String?
  parasutClientId       String?
  parasutClientSecret   String?
  parasutUsername       String?
  parasutPassword       String?
  parasutCompanyId      String?
  etsyAccessToken       String?
  etsyRefreshToken      String?
  etsyShopId            String?
  etsyTokenExpiresAt    DateTime?
  ebayAccessToken       String?
  ebayRefreshToken      String?
  ebayTokenExpiresAt    DateTime?
  wixAccessToken        String?
  wixRefreshToken       String?
  wixSiteId             String?
  wixInstanceId         String?
  wixTokenExpiresAt     DateTime?
  shopifyAccessToken    String?
  shopifyShopDomain     String?
  mngCustomerNumber     String?
  mngPassword           String?
  mngAppId              String?
  mngAppSecret          String?
  mngApiEnvironment     String?   @default("test")
  amazonAccessToken     String?
  amazonRefreshToken    String?
  amazonTokenExpiresAt  DateTime?
  amazonSellerId        String?
  amazonMarketplaceId   String?
  amazonMarketplaceIds  String[]  @default([])
  amazonRegion          String?   @default("eu")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AmazonProductCache {
  id              String   @id @default(uuid())
  asin            String
  marketplaceId   String
  imageUrl        String?
  weightKg        Float?
  countryOfOrigin String?
  brand           String?
  title           String?
  fetchedAt       DateTime @default(now())

  @@unique([asin, marketplaceId])
  @@index([fetchedAt])
}

model ShipperProfile {
  id                                String   @id @default(uuid())
  userId                            String   @unique
  shipperName                       String?
  shipperPersonName                 String?
  shipperPhoneNumber                String?
  shipperStreet1                    String?
  shipperStreet2                    String?
  shipperCity                       String?
  shipperStateCode                  String?
  shipperPostalCode                 String?
  shipperCountryCode                String?
  shipperTinNumber                  String?
  importerOfRecord                  String?
  fedexFolderId                     String?
  defaultCurrencyCode               String?  @default("USD")
  dutiesPaymentType                 String?  @default("SENDER")
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
  defaultCountryOfMfg               String?
  defaultHarmonizedCode             String?
  defaultPackagingType              String?
  defaultServiceType                String?
  defaultWeightKg                   Float?
  shipperTinType                    String?
  defaultShippingChargesPaymentType String?  @default("SENDER")
  user                              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LabelJob {
  id             String    @id @default(cuid())
  orderItemId    String
  carrier        String
  status         String
  pdfUrl         String?
  trackingNumber String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
}

model SenkronOrderData {
  id           String   @id @default(cuid())
  orderId      String   @unique
  userId       String
  internalNote String? // User's internal notes for the order
  customStatus String? // User's custom status (cancelled, inProduction, shipped, etc.)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order    @relation("OrderSenkronData", fields: [orderId], references: [id], onDelete: Cascade)
  user         User     @relation("UserSenkronData", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
}

model Shipment {
  id              String     @id @default(cuid())
  orderId         String
  orderItemId     String?
  carrier         String
  status          String
  pdfUrl          String?
  trackingNumber  String?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  serviceType     String?
  iossNumber      String?
  isEdi           Boolean?   @default(true)
  packageType     String?
  signatureOption String?
  /// status vocabulary adds 'void_requested' | 'voided'
  voidedAt        DateTime?
  voidError       String?
  voidMethod      String? // carrier_api | manual
  order           Order      @relation("OrderToShipment", fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@index([orderId, status])
}

model SyncLog {
  id        String   @id @default(cuid())
  level     String
  /// Coarse domain bucket so the admin cockpit can filter quickly:
  /// security | cron | integration | billing | extension | shipping | etgb | system | auth
  category  String?
  message   String
  userId    String?
  operation String?
  details   Json?
  error     String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([level])
  @@index([category])
  @@index([level, timestamp])
}

model SyncOperation {
  id        String          @id @default(cuid())
  userId    String
  type      String
  status    String
  metrics   Json
  retryOf   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  retryFrom SyncOperation?  @relation("RetryRelation", fields: [retryOf], references: [id], onDelete: Restrict, onUpdate: Restrict)
  retries   SyncOperation[] @relation("RetryRelation")
  user      User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model OrderShipping {
  id          String   @id @default(cuid())
  orderId     String   @unique
  firstName   String
  lastName    String?
  company     String?
  street1     String
  street2     String?
  city        String
  state       String?
  postalCode  String
  countryCode String
  phone       String
  insertedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation("OrderToOrderShipping", fields: [orderId], references: [id], onDelete: Cascade)
}

model EtsyAddress {
  id              String   @id @default(cuid())
  userId          String
  orderNumber     String
  etsyStoreId     String? // Etsy shop ID for multi-store support
  etsyStoreName   String? // Human-readable store name
  shippingAddress Json
  notes           String?
  shipByDate      String? // Ship by date from Etsy (e.g. "Ship by tomorrow")
  orderDate       String? // Order date from Etsy
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, etsyStoreId, orderNumber])
  @@index([userId, orderNumber])
  @@index([userId, etsyStoreId, orderNumber])
  @@index([orderNumber])
  @@index([createdAt])
}

model TrackingSubmission {
  id                String   @id @default(cuid())
  orderId           String
  trackingNumber    String
  carrierId         Int
  carrierName       String
  notifyCustomer    Boolean  @default(true)
  updateRemoteOrder Boolean  @default(true)
  submittedAt       DateTime @default(now())
  submittedBy       String
  status            String   @default("submitted")
  errorMessage      String?
  veeqoResponse     Json?

  // Etsy extension tracking push status
  etsySubmittedAt  DateTime?
  etsySubmitStatus String?   @default("pending") // pending | submitted | failed
  etsySubmitError  String?
  // etsySubmitStatus vocabulary adds 'submitted_external' | 'cancelled'
  closedReason     String?
  closedAt         DateTime?

  order Order @relation("OrderTrackingSubmissions", fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation("UserTrackingSubmissions", fields: [submittedBy], references: [id], onDelete: Cascade)

  @@unique([orderId, trackingNumber])
  @@index([orderId])
  @@index([submittedBy])
  @@index([submittedAt])
  @@index([orderId, trackingNumber])
  @@index([etsySubmitStatus])
}

model EtsyShop {
  id                String    @id @default(cuid())
  userId            String
  shopId            String    @unique // Etsy shop ID
  shopName          String? // Human readable shop name
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  isDefault         Boolean   @default(false) // Default shop for this user
  isActive          Boolean   @default(true) // Can be disabled without deleting
  lastListingSyncAt DateTime? // When listings were last synced from Etsy
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ---- Event backbone (W1) ----
  lastWebhookAt          DateTime?
  orderPollCursor        Int?
  lastOrderPollAt        DateTime?
  orderPollFailures      Int       @default(0)
  lastOrderReconcileAt   DateTime?
  lastListingReconcileAt DateTime?
  needsReauth            Boolean   @default(false)
  needsReauthAt          DateTime?
  tokenRefreshLeaseUntil DateTime?

  user              User                   @relation("UserEtsyShops", fields: [userId], references: [id], onDelete: Cascade)
  listings          EtsyListing[]          @relation("EtsyShopListings")
  drafts            EtsyListingDraft[]     @relation("EtsyShopDrafts")
  listingVersions   EtsyListingVersion[]
  listingDailyStats EtsyListingDailyStat[]
  seoExperiments    SeoExperiment[]

  @@unique([userId, shopId]) // One record per user-shop combination
  @@index([userId])
  @@index([shopId])
}

model EtsyListing {
  id            String @id @default(cuid())
  etsyShopId    String // Etsy shop ID
  etsyListingId BigInt // Etsy's listing_id (exceeds INT4 max)

  // Core
  title       String
  description String   @db.Text
  tags        String[]
  materials   String[]

  // Price
  priceAmount       Int    @default(0)
  priceDivisor      Int    @default(100)
  priceCurrencyCode String @default("USD")

  // Metrics
  views       Int @default(0)
  numFavorers Int @default(0)
  quantity    Int @default(0)

  // State
  state String  @default("draft")
  url   String?

  // Classification
  taxonomyId    Int?
  shopSectionId BigInt? // Etsy section ids exceed INT4 (e.g. 52047899318)
  whoMade       String?
  whenMade      String?
  isSupply      Boolean @default(false)

  // Processing
  processingMin Int?
  processingMax Int?

  // Shipping
  shippingProfileId BigInt?
  returnPolicyId    BigInt?

  // Dimensions
  itemWeight         Float?
  itemWeightUnit     String?
  itemLength         Float?
  itemWidth          Float?
  itemHeight         Float?
  itemDimensionsUnit String?

  // Personalization
  isPersonalizable            Boolean @default(false)
  personalizationIsRequired   Boolean @default(false)
  personalizationInstructions String?
  personalizationCharCountMax Int?

  // Images
  thumbnailUrl75x75   String?
  thumbnailUrl170x135 String?
  thumbnailUrl570xN   String?
  imageCount          Int     @default(0)
  hasVideo            Boolean @default(false)

  // Etsy timestamps
  etsyCreatedTimestamp Int @default(0)
  etsyUpdatedTimestamp Int @default(0)

  // Cache control
  syncedAt DateTime @default(now())

  // ---- Listing intel (W3) ----
  hasVariations      Boolean   @default(false)
  quantityOnProperty BigInt[]  @default([]) // custom variation property ids exceed INT4
  inventorySyncedAt  DateTime?
  contentHash        String?
  lastWebhookAt      DateTime?
  lastRefreshAt      DateTime?
  stateChangedAt     DateTime?

  etsyShop          EtsyShop              @relation("EtsyShopListings", fields: [etsyShopId], references: [shopId], onDelete: Cascade)
  offerings         EtsyListingOffering[]
  healthScore       Int?
  healthChecksUsed  Int                   @default(0)
  healthChecksTotal Int                   @default(0)
  healthFails       String[]              @default([])

  @@unique([etsyShopId, etsyListingId])
  @@index([etsyShopId])
  @@index([etsyShopId, state])
  @@index([etsyShopId, etsyCreatedTimestamp])
  @@index([etsyShopId, healthScore])
}

/// Cached Etsy inventory offerings keyed by variantKey (never product_id:
/// Etsy regenerates product ids on every inventory PUT).
model EtsyListingOffering {
  id              String      @id @default(cuid())
  etsyShopId      String
  etsyListingId   BigInt
  /// '' = no variations, '*' = shared quantity
  variantKey      String
  variantValueKey String
  /// informational only (Etsy regenerates it on each PUT)
  productId       BigInt?
  offeringId      BigInt?
  sku             String?
  skuNormalized   String?
  quantity        Int         @default(0)
  isEnabled       Boolean     @default(true)
  priceAmount     Int?
  priceDivisor    Int?
  propertyValues  Json        @default("[]")
  remoteUpdatedTs Int         @default(0)
  syncedAt        DateTime    @default(now())
  listing         EtsyListing @relation(fields: [etsyShopId, etsyListingId], references: [etsyShopId, etsyListingId], onDelete: Cascade)

  @@unique([etsyShopId, etsyListingId, variantKey])
  @@index([etsyShopId, skuNormalized])
}

/// Listing version history with attribution.
model EtsyListingVersion {
  id              String   @id @default(cuid())
  userId          String
  etsyShopId      String
  etsyListingId   BigInt
  remoteUpdatedTs Int      @default(0)
